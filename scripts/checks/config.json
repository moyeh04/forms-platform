{
  "baseline": "baseline.json",
  "exceptions": "exceptions.json",
  "docs": {
    "api": "docs/backend/API.md",
    "testing": "docs/process/TESTING.md",
    "tests": "tests",
    "backend": {
      "include": ["backend/"],
      "extensions": [".gs", ".js"]
    }
  },
  "biome": {
    "include": [
      "assets/js/",
      "assets/css/",
      "backend/",
      "shared/",
      "scripts/",
      "tests/",
      "package.json",
      "biome.json"
    ],
    "extensions": [".js", ".css", ".json"],
    "exclude": ["tests/fixtures/"]
  },
  "lines": {
    "limit": 80,
    "include": [
      "assets/",
      "backend/",
      "shared/",
      "scripts/",
      "tests/",
      ".githooks/",
      ".github/",
      "index.html",
      "admin.html",
      "viewer.html",
      "biome.json",
      "package.json"
    ],
    "extensions": [".js", ".gs", ".css", ".html", ".sh", ".yml", ".json", ""],
    "exclude": ["tests/fixtures/", "package-lock.json"]
  },
  "jsdoc": {
    "include": ["assets/js/", "backend/", "shared/", "scripts/"],
    "extensions": [".js", ".gs"],
    "exclude": ["assets/js/config.js"],
    "forbiddenTags": [
      "author",
      "date",
      "since",
      "version",
      "copyright",
      "license",
      "created",
      "modified",
      "file",
      "fileoverview"
    ]
  },
  "numbers": {
    "include": ["assets/js/", "backend/", "shared/", "scripts/"],
    "extensions": [".js", ".gs"],
    "allowed": [0, 1, 2, 10, 24, 60]
  },
  "flags": {
    "include": ["assets/js/", "backend/", "shared/"],
    "extensions": [".js", ".gs"],
    "exclude": []
  }
}
