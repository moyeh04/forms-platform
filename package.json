{
  "name": "forms-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Student forms: static pages with an Apps Script backend.",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "node scripts/checks/run-checks.js --all",
    "build": "node scripts/build/bundle-backend.js",
    "build:site": "node scripts/build/build-site.js",
    "setup": "node scripts/deploy/setup-deployment.js",
    "dev": "node scripts/dev/dev-server.js",
    "prepare": "sh scripts/dev/setup-git.sh"
  },
  "devDependencies": {
    "acorn": "8.14.1",
    "acorn-walk": "8.3.4",
    "jsdom": "^24.1.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006"
  },
  "packageManager": "pnpm@12.18.0"
}
