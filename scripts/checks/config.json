{
  "baseline": "baseline.json",
  "exceptions": "exceptions.json",
  "docs": {
    "api": "docs/backend/API.md",
    "testing": "docs/process/TESTING.md",
    "tests": "tests",
    "backend": {
      "include": ["backend/"],
      "extensions": [".gs", ".js"]
    }
  },
  "biome": {
    "include": [
      "assets/js/",
      "assets/css/",
      "backend/",
      "shared/",
      "scripts/",
      "tests/",
      "package.json",
      "biome.json"
    ],
    "extensions": [".js", ".css", ".json"],
    "exclude": ["tests/fixtures/"]
  },
  "lines": {
    "limit": 80,
    "include": [
      "assets/",
      "backend/",
      "shared/",
      "scripts/",
      "tests/",
      ".githooks/",
      ".github/",
      "index.html",
      "admin.html",
      "viewer.html",
      "biome.json",
      "package.json"
    ],
    "extensions": [".js", ".gs", ".css", ".html", ".sh", ".yml", ".json", ""],
    "exclude": ["tests/fixtures/", "package-lock.json"]
  }
}
