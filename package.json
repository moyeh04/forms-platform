{
  "name": "forms-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-form registration, reservation and task platform: static frontend plus a Google Apps Script backend that stores everything in Google Sheets.",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "node scripts/checks/run-checks.js --all",
    "build": "node scripts/build/bundle-backend.js",
    "build:site": "node scripts/build/build-site.js",
    "setup": "node scripts/deploy/setup-deployment.js",
    "dev": "node scripts/dev/dev-server.js",
    "prepare": "sh scripts/dev/setup-git.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "acorn": "8.14.1",
    "acorn-walk": "8.3.4",
    "jsdom": "^24.1.0"
  },
  "license": "UNLICENSED"
}
